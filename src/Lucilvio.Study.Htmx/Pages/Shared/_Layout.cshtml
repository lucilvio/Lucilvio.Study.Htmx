@using global::Htmx.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="htmx-config" includeAspNetAntiforgeryToken="true" />
    <title>@ViewData["Title"] - Lucilvio.Study.Htmx</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lucilvio.Study.Htmx.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Lucilvio.Study.Htmx</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>
    <footer class="mt-auto bg-light text-center py-3 border-top">
        <div class="container">
            &copy; 2025 - Lucilvio.Study.Htmx - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @await Html.PartialAsync("_ConfirmationDialog")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="@HtmxAntiforgeryScriptEndpoints.Path"></script>
    <script src="~/js/_htmx/confirmation-dialog.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>